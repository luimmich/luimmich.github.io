<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <meta name="mobile-web-app-capable" content="yes">
    
    <!-- Mantenha esta para compatibilidade com versões antigas do iOS -->
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black">
    <meta name="theme-color" content="#000000">
    <title>Simple Scale</title>
    <link rel="preload" href="/fonts/departuremono/DepartureMono-Regular.woff2" as="font" type="font/woff2" crossorigin>
    
    <link rel="stylesheet" href="/css/scale.css">
    <link rel="stylesheet" href="/fonts/departuremono/departure.css">
    <link rel="manifest" href="/simple-scale/manifest.json">

    <link rel="apple-touch-icon" sizes="180x180" href="/icons/scale/favicon/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/scale/favicon/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/icons/scale/favicon/favicon-16x16.png">

</head>
<body class="state-disconnected">

    <!-- OVERLAY DE DESCONEXÃO -->
    <div id="connection-overlay" class="overlay">
        <button id="btn-connect" class="btn-overlay">
            connect
        </button>
        <button id="btn-simulate" class="btn-overlay">
            dev 
        </button>
    </div>

    <!-- TELA DE ESTATÍSTICAS (Modular Full Screen) -->
        <div id="stats-screen" class="stats-overlay">
            
            <header class="stats-nav">
                <button id="btn-close-stats" class="stats-nav-btn">< stats</button>
            
                <button class="stats-nav-btn">pourover</button>
            </header>

            <div class="stats-modules-grid">
                
                <!-- Módulo Hero: Extrações Totais (Dark Mode) -->
                <div class="stat-module module-dark hero-module">
                    <span class="module-lbl">total brews</span>
                    <div id="stat-brews" class="module-val-huge">0</div>
                </div>

                <!-- Módulo: Volume Médio (ML) -->
                <div class="stat-module module-light">
                    <span class="module-lbl">avg yield</span>
                    <div class="module-val-group">
                        <div id="stat-avg-yield" class="module-val">0</div>
                        <span class="module-unit">ml</span>
                    </div>
                </div>

                <!-- Módulo: Despejos (Pours) -->
                <div class="stat-module module-light">
                    <span class="module-lbl">avg pours</span>
                    <div class="module-val-group">
                        <div id="stat-avg-pours" class="module-val">0</div>
                        <span class="module-unit">x</span>
                    </div>
                </div>

                <!-- Módulo: Tempo Médio -->
                <div class="stat-module module-light">
                    <span class="module-lbl">avg time</span>
                    <div id="stat-avg-time" class="module-val">0:00</div>
                </div>

                <!-- Módulo: Café Estimado -->
                <div class="stat-module module-light">
                    <span class="module-lbl">est. coffee</span>
                    <div class="module-val-group">
                        <div id="stat-total-coffee" class="module-val">0</div>
                        <span class="module-unit">g</span>
                    </div>
                </div>

                <!-- Módulo de Histórico (Scroll Interno) -->
                <div class="stat-module module-dark history-module">
                    <span class="module-lbl">brew history</span>
                    <ul id="history-list" class="history-list">
                        <!-- Itens injetados via JavaScript -->
                    </ul>
                </div>

                <!-- Módulo de Ação: Exportação -->
                <button id="btn-export" class="stat-module module-light module-action">
                    <span class="module-lbl">system</span>
                    <div class="module-val-group">
                        <div class="module-val">export</div>
                        <span class="module-unit">.json</span>
                    </div>
                </button>
            </div>
        </div>

    <!-- O PAINEL DE EXTRAÇÃO (Stack Vertical) -->
    <main class="app-layout">
        
       <header class="top-nav">
            <!-- BLE agora fica na esquerda -->
            <div id="status-indicator" class="nav-item">ble</div>
            
            <!-- Ponto de estabilidade agora fica na direita -->
            <div id="stable-dot" class="stable-dot"></div>
        </header>

        <!-- DADOS GIGANTES (Tempo e Peso empilhados) -->
        <section class="metrics-stack">
            
            <div class="metric-row">
                <span class="tiny-label">time</span>
                <div class="metric-value-group">
                    <div id="val-time" class="hero-metric">0:00</div>
                    <span class="tiny-unit">s</span>
                </div>
            </div>

            <div class="metric-row">
                <span class="tiny-label">weight</span>
                <div class="metric-value-group">
                    <div id="val-weight" class="hero-metric">0.0</div>
                    <span class="tiny-unit">g</span>
                </div>
            </div>

        </section>


        <!-- GRÁFICO DE SINAL (Flow em Linha) -->
        <section class="signal-graph-container">
            <div class="signal-header">
                <span class="tiny-label">flow</span>
                <span id="val-flow-numeric" class="tiny-unit">0.0 g/s</span>
            </div>
            <canvas id="flow-canvas" class="signal-canvas"></canvas>
        </section>

        <!-- RODAPÉ (Ações) -->
        <footer class="action-footer">
            <button id="btn-timer" class="action-btn">
                <img id="timer-icon" src="/icons/scale/play.svg" alt="Timer">
            </button>
            <button id="btn-tare" class="action-btn">T</button>
        </footer>
    </main>
    <script type="module" src="/js/scale/app.js"></script>
</body>
</html>