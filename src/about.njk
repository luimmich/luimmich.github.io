---
layout: base.njk
title: Sobre
permalink: "/sobre/"
custom_css: "about.css"
priority: 0.9
changefreq: "weekly"
---

<main class="about-cv">
  
  <!-- CABEÇALHO -->
  <div class="cv-grid cv-header">
    <div class="cv-img-header cv-img-wrapper reveal-element">
      {% image "/project-files/about/lu-immich.jpg", "Lu Immich", "funnel-img" %}
    </div>
    <div id="contact"></div>
    <div class="cv-contact reveal-element">
      <a href="https://lattes.cnpq.br/6938481194529175" target="_blank" rel="noopener">Lattes</a>
      <a href="https://github.com/luimmich" target="_blank" rel="noopener">GitHub</a>
      <a href="https://www.instagram.com/luimmich" target="_blank" rel="noopener">Instagram</a>
      <a href="https://philpeople.org/profiles/lu-immich" target="_blank" rel="noopener">PhilPeople</a>
      <a href="https://scholar.google.com/citations?user=c6EDyWMAAAAJ" target="_blank" rel="noopener">Google Scholar</a>
      <a href="mailto:lu.immich@gmail.com">lu.immich@gmail.com</a>
    </div>
    <p class="cv-intro-text reveal-element">{{ about.intro | safe }}</p>
  </div>

  <!-- A NOVA SANFONA DINÂMICA -->
  <div class="cv-content reveal-element fade-on-scroll">
    <div class="philosophy-groups-content">
      <p class="philosophy-groups-title">Saiba mais</p>
    </div>
    <ul class="accordion-list reveal-element">
      {% for item in about.accordion %}
      <li class="accordion-item{% if item.hideOnMobile %} hidden-mobile{% endif %}{% if item.hideOnDesktop %} hidden-desktop{% endif %}">
        <button type="button" class="accordion-header" aria-expanded="false">
          <span class="accordion-title">{{ item.title }}</span>
          <span class="accordion-icon">+</span>
        </button>
        <div class="accordion-content">
          <div class="accordion-inner">
            
            <!-- Renderiza Texto -->
            {% if item.type == 'text' %}
              <p>{{ item.content | safe }}</p>
            
            <!-- Renderiza Listas -->
            {% elif item.type == 'list' %}
              <ul class="cv-list">
                {% for listItem in item.items %}
                  <li>{{ listItem }}</li>
                {% endfor %}
              </ul>
            
            <!-- Renderiza Gráficos/Tabelas -->
            {% elif item.type == 'chart' %}
              <div class="cv-chart-list">
                {% for chartItem in item.items %}
                <div class="cv-chart-item">
                  <span class="cv-chart-label">{{ chartItem.name }}</span>
                  <div class="cv-chart-track">
                    <div class="cv-chart-fill" style="width: {{ chartItem.level }}%;"></div>
                  </div>
                </div>
                {% endfor %}
              </div>
            {% endif %}

          </div>
        </div>
      </li>
      {% endfor %}
    </ul>
  </div>
</main>