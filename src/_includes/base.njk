<!DOCTYPE html>
<html lang="{{ 'en-US' if locale == 'en' else 'pt-BR' }}">
<head>
  <meta charset="UTF-8">

  <meta http-equiv="Content-Security-Policy" content="script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cloud.umami.is;">

  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="google-site-verification" content="o2YMMty1BEuB8c6x55yYYqjvDjgNujVhYwkxwE9V5Gg" />

 <!-- SEO BÁSICO -->
  <title>{% if page.url == '/' or page.url == '/en/' %}{{ site[locale].name }} | {{ site[locale].description }}{% elif title %}{{ title | safe }} | {{ site[locale].name }}{% else %}{{ site[locale].name }}{% endif %}</title>
  <meta name="description" content="{{ description | default(site[locale].description) }}">
  <meta name="author" content="{{ site[locale].author }}">
  <meta name="keywords" content="{{ keywords | default(locales.seo.keywords[locale]) }}">
  <meta name="theme-color" content="#ffffff" />

  <!-- Canonical URL -->
  <link rel="canonical" href="{{ site[locale].url }}{{ page.url }}">
  
  <!-- OPEN GRAPH / REDES SOCIAIS -->
  <meta property="og:type" content="{% if isProject %}article{% else %}website{% endif %}">
  <meta property="og:url" content="{{ site[locale].url }}{{ page.url }}">
  <meta property="og:title" content="{% if page.url == '/' or page.url == '/en/' %}{{ site[locale].name }} | {{ site[locale].description }}{% elif title %}{{ title | safe }} | {{ site[locale].name }}{% else %}{{ site[locale].name }}{% endif %}">
  <meta property="og:description" content="{{ description | default(site[locale].description) }}">
  <meta property="og:image" content="{{ site[locale].url }}{{ image | default('/icons/favicon/android-chrome-512x512.png') }}">
  
  <!-- TWITTER CARDS -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{% if page.url == '/' or page.url == '/en/' %}{{ site[locale].name }} | {{ site[locale].description }}{% elif title %}{{ title | safe }} | {{ site[locale].name }}{% else %}{{ site[locale].name }}{% endif %}">
  <meta name="twitter:description" content="{{ description | default(site[locale].description) }}">
  <meta name="twitter:image" content="{{ site[locale].url }}{{ image | default('/icons/favicon/android-chrome-512x512.png') }}">

  <!-- JSON-LD GLOBAL -->
  {% if page.url != '/sobre/' and page.url != '/en/about/' and page.url != '/filosofia/' and page.url != '/en/philosophy/' %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "{% if isProject %}CreativeWork{% else %}Person{% endif %}",
    "name": "{% if title %}{{ title | safe }}{% else %}{{ site[locale].name }}{% endif %}",
    "description": "{{ description | default(site[locale].description) }}",
    "url": "{{ site[locale].url }}{{ page.url }}",
    {% if not isProject %}
    "jobTitle": "{{ locales.seo.jobTitleGlobal[locale] }}",
    "affiliation": {
      "@type": "Organization",
      "name": "Universidade Federal de Santa Maria"
    },
    {% endif %}
    "author": {
      "@type": "Person",
      "name": "{{ site[locale].author }}"
    }
  }
  </script>
  {% endif %}

  <!-- Links CSS e Fontes -->
  <link rel="preload" href="/fonts/jost/jost-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/style.css" type="text/css" charset="utf-8" />
  
  {% if custom_css %}
  <link rel="stylesheet" href="/css/{{ custom_css }}" type="text/css" charset="utf-8" />
  {% endif %}
  
  <link rel="stylesheet" href="/fonts/jost/Jost.css" type="text/css" charset="utf-8" />
  
  <!-- Favicons -->
  <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon/favicon-16x16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/icons/favicon/apple-touch-icon.png">
  <link rel="manifest" href="/icons/favicon/site.webmanifest">

  <!-- Analytics -->
  <script defer src="https://cloud.umami.is/script.js" data-website-id="91642bab-227b-4ca6-ad87-ab49f95f044e"></script>

  <!-- GEO: Schema Markup da página Sobre -->
  {% if page.url == '/sobre/' or page.url == '/en/about/' %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Lu Immich",
    "url": "{{ site.url }}{{ page.url }}",
    "jobTitle": {{ locales.seo.jobTitleAbout[locale] | dump | safe }},
    "description": "{{ locales.seo.aboutDescription[locale] }}",
    "alumniOf": {
      "@type": "CollegeOrUniversity",
      "name": "Universidade Federal de Santa Maria (UFSM)",
      "sameAs": "https://www.ufsm.br/"
    },
    "knowsAbout": [
      "Ontologia Social",
      "Filosofia Trans",
      "Filosofia Social",
      "Filosofia Política",
      "UI/UX Design",
      "Web Design",
      "Design Gráfico",
      "Web Development"
    ],
    "sameAs": [
      "https://lattes.cnpq.br/6938481194529175",
      "https://github.com/luimmich",
      "https://www.instagram.com/luimmich",
      "https://philpeople.org/profiles/lu-immich",
      "https://scholar.google.com/citations?user=c6EDyWMAAAAJ"
    ]
  }
  </script>

  {% set faqs = about[locale].accordion | selectattr("isFaq") %}
  {% if faqs | length > 0 %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {% for faq in faqs %}
      {
        "@type": "Question",
        "name": "{{ faq.title | striptags | replace('\"', '\\\"') | safe }}",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "{{ faq.content | striptags | replace('\"', '\\\"') | replace('\n', ' ') | safe }}"
        }
      }{% if not loop.last %},{% endif %}
      {% endfor %}
    ]
  }
  </script>
  {% endif %}
  {% endif %}

  <!-- GEO: Schema Markup da página Filosofia -->
  {% if page.url == '/filosofia/' or page.url == '/en/philosophy/' %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "ProfilePage",
        "@id": "{{ site.url }}{{ page.url }}#webpage",
        "url": "{{ site.url }}{{ page.url }}",
        "name": "{{ title | safe }} - Lu Immich",
        "mainEntity": { "@id": "{{ site.url }}/#person" }
      },
      {
        "@type": "Person",
        "@id": "{{ site.url }}/#person",
        "name": "Lu Immich",
        "jobTitle": "{{ locales.seo.jobTitleAbout[locale][0] }}",
        "description": "{{ locales.seo.philosophyDescription[locale] }}",
        "affiliation": {
          "@type": "CollegeOrUniversity",
          "name": "Universidade Federal de Santa Maria (UFSM)",
          "sameAs": "https://www.ufsm.br/"
        },
        "knowsAbout": [
          "Ontologia Social",
          "Filosofia Trans",
          "Engenharia Conceitual de Gênero",
          "Framework Conferista",
          "Metafísica Feminista"
        ],
        "memberOf": [
          {% for group in philosophy_groups[locale] %}
          {
            "@type": "Organization",
            "name": "{{ group.title | striptags | safe }}"
          }{% if not loop.last %},{% endif %}
          {% endfor %}
        ]
      }{% if philosophy[locale].length > 0 %},{% endif %}
      {% for book in philosophy[locale] %}
      {
        "@type": "ScholarlyArticle",
        "headline": "{{ book.title | safe }}{% if book.subtitle %}: {{ book.subtitle | safe }}{% endif %}",
        "author": { "@id": "{{ site.url }}/#person" },
        "publisher": {
          "@type": "Organization",
          "name": "{{ book.publication | safe }}"
        },
        "abstract": "{{ book.excerpt | replace('\n', ' ') | replace('\"', '\\\"') | safe }}"{% if book.link %},
        "url": "{{ book.link | safe }}"{% endif %}
      }{% if not loop.last %},{% endif %}
      {% endfor %}
    ]
  }
  </script>
  {% endif %}
</head>

<body>
  <nav class="nav">
    <a class="nav-title" href="{{ locales.nav.home.url[locale] }}">Lu Immich</a>
    
    <div class="language-switcher-wrapper">
      
      <!-- INÍCIO: Language Switcher Inteligente -->
      {% set switchUrl = translatedUrl %}
      {% if not switchUrl %}
        {% if locale == 'pt' %}
          {% set switchUrl = "/en" ~ page.url %}
        {% else %}
          {% set switchUrl = page.url | replace("/en/", "/") %}
        {% endif %}
      {% endif %}

      <a href="{{ switchUrl }}" class="small-caps language-switcher aria-label="{{ 'Change language' if locale == 'en' else 'Mudar idioma' }}">
        {{ 'PT' if locale == 'en' else 'EN' }}
      </a>
      <!-- FIM: Language Switcher Inteligente -->
      
      <button class="mobile-menu-btn small-caps" aria-label="{{ locales.nav.menu[locale] }}" aria-expanded="false">
        {{ locales.nav.menu[locale] }}
      </button>
    </div>
  </nav>

  <!-- Menu Overlay -->
  <div class="mobile-overlay">
    <div class="mobile-overlay-header">
      <span class="mobile-overlay-title">Lu Immich</span>
      <button class="mobile-close-btn small-caps" aria-label="{{ locales.nav.close[locale] }}">{{ locales.nav.close[locale] }}</button>
    </div>

    <div class="mobile-overlay-content">
      <ul class="mobile-nav-list">
        <li><a href="{{ locales.nav.home.url[locale] }}"><span class="nav-number">[&nbsp&nbsp]</span> {{ locales.nav.home[locale] }}</a></li>
        <li><a href="{{ locales.nav.philosophy.url[locale] }}"><span class="nav-number">[&nbsp&nbsp]</span> {{ locales.nav.philosophy[locale] }}</a></li>
        <li><a href="{{ locales.nav.design.url[locale] }}"><span class="nav-number">[&nbsp&nbsp]</span> {{ locales.nav.design[locale] }}</a></li>
        <li><a href="{{ locales.nav.about.url[locale] }}"><span class="nav-number">[&nbsp&nbsp]</span> {{ locales.nav.about[locale] }}</a></li>
      </ul>
    </div>
  </div>

  {{ content | safe }}

  <footer class="flex--column">
    <div class="footer-license">
      <a class="made-with-love heart-cursor" href="{{ locales.nav.about.url[locale] }}#contact">{{ locales.footer.madeWithLove[locale] }}</a>
      
      <a class="license-icons" href="https://creativecommons.org/licenses/by-nc-nd/4.0/" target="_blank" rel="noopener">
        <img src="/icons/license/cc.svg" alt="CC">
        <img src="/icons/license/by.svg" alt="BY">
        <img src="/icons/license/nc.svg" alt="NC">
        <img src="/icons/license/nd.svg" alt="ND">
      </a>
    </div>
  </footer>

  <script src="/js/menu.js" defer></script>
  <script src="/js/animations.js" defer></script>
</body>
</html>