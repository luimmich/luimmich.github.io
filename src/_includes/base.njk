<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">

  <meta http-equiv="Content-Security-Policy" content="script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cloud.umami.is;">

  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="google-site-verification" content="o2YMMty1BEuB8c6x55yYYqjvDjgNujVhYwkxwE9V5Gg" />

  <!-- SEO BÁSICO -->
  <title>{% if page.url == '/' %}{{ site.name }} | Portfólio de Filosofia e Design{% elif title %}{{ site.name }} | {{ title }}{% else %}{{ site.name }}{% endif %}</title>
  <meta name="description" content="{{ description | default(site.description) }}">
  <meta name="author" content="{{ site.author }}">
  <meta name="keywords" content="{{ keywords | default('Lu Immich, design, filosofia, ontologia social, desenho industrial, ui/ux') }}">
  <meta name="theme-color" content="#ffffff" />

  <!-- Canonical URL -->
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  
  <!-- OPEN GRAPH / REDES SOCIAIS -->
  <meta property="og:type" content="{% if isProject %}article{% else %}website{% endif %}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:title" content="{% if page.url == '/' %}{{ site.name }} | Portfólio de Filosofia e Design{% elif title %}{{ title }} | {{ site.name }}{% else %}{{ site.name }}{% endif %}">
  <meta property="og:description" content="{{ description | default(site.description) }}">
  <meta property="og:image" content="{{ site.url }}{{ image | default('/icons/favicon/android-chrome-512x512.png') }}">
  
  <!-- TWITTER CARDS -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{% if page.url == '/' %}{{ site.name }} | Portfólio de Filosofia e Design{% elif title %}{{ title }} | {{ site.name }}{% else %}{{ site.name }}{% endif %}">
  <meta name="twitter:description" content="{{ description | default(site.description) }}">
  <meta name="twitter:image" content="{{ site.url }}{{ image | default('/icons/favicon/android-chrome-512x512.png') }}">

  <!-- JSON-LD GLOBAL (Desativado na Sobre e Filosofia para evitar duplicação) -->
  {% if page.url != '/sobre/' and page.url != '/filosofia/' %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "{% if isProject %}CreativeWork{% else %}Person{% endif %}",
    "name": "{% if title %}{{ title }}{% else %}{{ site.name }}{% endif %}",
    "description": "{{ description | default(site.description) }}",
    "url": "{{ site.url }}{{ page.url }}",
    {% if not isProject %}
    "jobTitle": "Filósofa e Designer",
    "affiliation": {
      "@type": "Organization",
      "name": "Universidade Federal de Santa Maria"
    },
    {% endif %}
    "author": {
      "@type": "Person",
      "name": "{{ site.author }}"
    }
  }
  </script>
  {% endif %}

  <!-- Links CSS e Fontes -->
  <link rel="preload" href="/fonts/jost/jost-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/style.css" type="text/css" charset="utf-8" />
  
  <!-- CSS Dinâmico -->
  {% if custom_css %}
  <link rel="stylesheet" href="/css/{{ custom_css }}" type="text/css" charset="utf-8" />
  {% endif %}
  
  <link rel="stylesheet" href="/fonts/jost/Jost.css" type="text/css" charset="utf-8" />
  
  <!-- Favicons -->
  <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon/favicon-16x16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/icons/favicon/apple-touch-icon.png">
  <link rel="manifest" href="/icons/favicon/site.webmanifest">

  <!-- Analytics -->
  <script defer src="https://cloud.umami.is/script.js" data-website-id="91642bab-227b-4ca6-ad87-ab49f95f044e"></script>

<!-- GEO: Schema Markup de Entidade (Person) e FAQ para a página Sobre -->
  {% if page.url == '/sobre/' %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Lu Immich",
    "url": "https://luimmich.github.io/sobre/",
    "jobTitle": [
      "Doutoranda em Filosofia",
      "UI/UX Designer",
      "Desenvolvedora Web"
    ],
    "description": "A pesquisa acadêmica de Lu Immich concentra-se na ontologia social, área na qual ela investiga a existência trans em contextos não ideais. Atualmente, Lu é doutoranda em Filosofia pela Universidade Federal de Santa Maria (UFSM), com experiência em design e desenvolvimento web.",
    "alumniOf": {
      "@type": "CollegeOrUniversity",
      "name": "Universidade Federal de Santa Maria (UFSM)",
      "sameAs": "https://www.ufsm.br/"
    },
    "knowsAbout": [
      "Ontologia Social",
      "Filosofia Trans",
      "Filosofia Social",
      "Filosofia Política",
      "UI/UX Design",
      "Web Design",
      "Design Gráfico",
      "Web Development"
    ],
    "sameAs": [
      "https://lattes.cnpq.br/6938481194529175",
      "https://github.com/luimmich",
      "https://www.instagram.com/luimmich",
      "https://philpeople.org/profiles/lu-immich",
      "https://scholar.google.com/citations?user=c6EDyWMAAAAJ"
    ]
  }
  </script>

  <!-- GEO: Schema Markup de FAQPage Dinâmico (Lê a tag isFaq do about.json) -->
  {% set faqs = about.accordion | selectattr("isFaq") %}
  {% if faqs | length > 0 %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {% for faq in faqs %}
      {
        "@type": "Question",
        "name": "{{ faq.title | replace('\"', '\\\"') | safe }}",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "{{ faq.content | replace('\"', '\\\"') | replace('\n', ' ') | safe }}"
        }
      }{% if not loop.last %},{% endif %}
      {% endfor %}
    ]
  }
  </script>
  {% endif %}
  {% endif %}

  <!-- GEO: Schema Markup de Grafo Acadêmico para a página Filosofia -->
  {% if page.url == '/filosofia/' %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "ProfilePage",
        "@id": "https://luimmich.github.io/filosofia/#webpage",
        "url": "https://luimmich.github.io/filosofia/",
        "name": "Filosofia - Lu Immich",
        "mainEntity": { "@id": "https://luimmich.github.io/#person" }
      },
      {
        "@type": "Person",
        "@id": "https://luimmich.github.io/#person",
        "name": "Lu Immich",
        "jobTitle": "Doutoranda em Filosofia",
        "description": "Pesquisadora em Ontologia Social com foco em categorias de gênero trans e estratégias de resistência à opressão em contextos não ideais, utilizando um framework conferista e engenharia conceitual.",
        "affiliation": {
          "@type": "CollegeOrUniversity",
          "name": "Universidade Federal de Santa Maria (UFSM)",
          "sameAs": "https://www.ufsm.br/"
        },
        "knowsAbout": [
          "Ontologia Social",
          "Filosofia Trans",
          "Engenharia Conceitual de Gênero",
          "Framework Conferista",
          "Metafísica Feminista"
        ],
        "memberOf": [
          {% for group in philosophy_groups %}
          {
            "@type": "Organization",
            "name": "{{ group.title | safe }}"
          }{% if not loop.last %},{% endif %}
          {% endfor %}
        ]
      }{% if philosophy.length > 0 %},{% endif %}
      {% for book in philosophy %}
      {
        "@type": "ScholarlyArticle",
        "headline": "{{ book.title | safe }}{% if book.subtitle %}: {{ book.subtitle | safe }}{% endif %}",
        "author": { "@id": "https://luimmich.github.io/#person" },
        "publisher": {
          "@type": "Organization",
          "name": "{{ book.publication | safe }}"
        },
        "abstract": "{{ book.excerpt | replace('\n', ' ') | replace('\"', '\\\"') | safe }}"{% if book.link %},
        "url": "{{ book.link | safe }}"{% endif %}
      }{% if not loop.last %},{% endif %}
      {% endfor %}
    ]
  }
  </script>
  {% endif %}
</head>

<body>
  <nav class="nav">
    <a class="nav-title" href="/">Lu Immich</a>
    <button class="mobile-menu-btn small-caps" aria-label="Abrir menu" aria-expanded="false">
      Menu
    </button>
  </nav>

  <!-- Menu Overlay -->
  <div class="mobile-overlay">
    <div class="mobile-overlay-header">
      <span class="mobile-overlay-title">Lu Immich</span>
      <button class="mobile-close-btn small-caps" aria-label="Fechar menu">Fechar</button>
    </div>

    <div class="mobile-overlay-content">
      <ul class="mobile-nav-list">
        <li><a href="/"><span class="nav-number">[&nbsp&nbsp]</span> Home</a></li>
        <li><a href="/filosofia/"><span class="nav-number">[&nbsp&nbsp]</span> Filosofia</a></li>
        <li><a href="/design/"><span class="nav-number">[&nbsp&nbsp]</span> Design</a></li>
        <li><a href="/sobre/"><span class="nav-number">[&nbsp&nbsp]</span> Sobre</a></li>
      </ul>
    </div>
  </div>

  {{ content | safe }}

  <footer class="flex--column">
    <div class="footer-license">
      <a class="made-with-love heart-cursor" href="/sobre/#contact">Feito com amor por Lu Immich</a>
      
      <a class="license-icons" href="https://creativecommons.org/licenses/by-nc-nd/4.0/">
        <img src="/icons/license/cc.svg" alt="CC">
        <img src="/icons/license/by.svg" alt="BY">
        <img src="/icons/license/nc.svg" alt="NC">
        <img src="/icons/license/nd.svg" alt="ND">
      </a>
    </div>
  </footer>

  <script src="/js/menu.js" defer></script>
  <script src="/js/animations.js" defer></script>
</body>
</html>