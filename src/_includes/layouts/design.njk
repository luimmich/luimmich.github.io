---
layout: base.njk
custom_css: "archive.css"
priority: 0.8
---

<main>
  <section class="archive-hero">
    <div class="archive-links-container">
      
      <!-- Lendo do idioma correto -->
      {% for sheet in archive[locale] %}
      <div class="archive-link">
        <button class="archive-tag-container" 
                data-target="{{ sheet.id }}" 
                aria-expanded="false"
                style="--tab-offset: {{ sheet.offsetDesktop | default('2vw') }}; --tab-offset-mobile: {{ sheet.offsetMobile | default('2vw') }};">
          <div class="archive-tag"></div>
          <div class="archive-tag-small">
            <p class="archive-tag-year">{{ sheet.category }}</p>
          </div>
        </button>
        <div class="line"></div>
      </div>
      {% endfor %}
      
      <!-- Tag Vazia do Fundo -->
      <div class="archive-link">
        <button class="archive-tag-container" id="archive-link-empty" style="cursor: default;">
          <div class="archive-tag"></div>
          <div class="archive-tag-small"></div>
          <p class="archive-tag-year"></p>
        </button>
        <div class="line"></div>
      </div>

    </div>
    
    <div class="archive-front-container">
      <div class="archive-front-top"></div>
      <div class="archive-front"></div>
    </div>
  </section>

  <section class="archive-sheets-container">
    
    <!-- Lendo do idioma correto -->
    {% for sheet in archive[locale] %}
    <div class="archive-sheet" id="archive-sheet-{{ sheet.id }}">
      
      <div class="archive-tag-container">
        <div class="archive-tag"></div>
        <div class="archive-tag-small"></div>
        <p class="archive-tag-year">{{ sheet.category }}</p>
      </div>
      
      <div class="archive-item-container">
        {% for item in sheet.items %}
        <div class="archive-item">
          <a {% if item.url %}href="{{ item.url }}"{% endif %}>
            {% set imgClass = "archive-img border-img" if item.border else "archive-img" %}
            {% image item.image, item.alt, imgClass, "(max-width: 768px) 50vw, 400px" %}
          </a>
        </div>
        {% endfor %}
      </div>
      
    </div>
    {% endfor %}
    
  </section>

  <!-- Botão Traduzido Dinamicamente -->
  <button id="close-folder-btn" class="close-folder-btn" aria-label="{{ locales.designPage.closeFolderAria[locale] }}">
    {{ locales.designPage.closeFolder[locale] }}
  </button>

</main>

<script src="/js/archive.js" defer></script>