---
layout: base.njk
---

<main class="hero">
  <ul id="hero-list">
    <!-- O JavaScript injeta os projetos aqui de forma síncrona -->
  </ul>
</main>

<section class="home-container">
  
  <div class="grid-home home-funnel-cards">
    <!-- CARD 1: DESIGN -->
    <a href="{{ locales.homePage.designUrl[locale] }}" class="design-card funnel-card reveal-element">
      <div class="funnel-img-wrapper">
        {% image "/project-files/desan/desan1.webp", locales.homePage.designTitle[locale], "funnel-img" %}
      </div>
      <div class="funnel-meta">
        <p class="small-caps">{{ locales.homePage.designTitle[locale] }}</p>
      </div>
    </a>

    <!-- CARD 2: FILOSOFIA -->
    <a href="{{ locales.homePage.philosophyUrl[locale] }}" class="philosophy-card funnel-card reveal-element"> 
      <div class="funnel-img-wrapper">
        {% image "/imgs/home/home-philosophy.jpg", locales.homePage.philosophyTitle[locale], "funnel-img" %}
      </div>
      <div class="funnel-meta">
        <p class="small-caps">{{ locales.homePage.philosophyTitle[locale] }}</p>
      </div>
    </a>
  </div>
  
  <!-- CABEÇALHO SOBRE MIM -->
  <div class="grid-home home-funnel-header reveal-element">
    <div class="funnel-img-home funnel-img-wrapper">
      {% image "/imgs/about/lu-immich.jpg", "Lu Immich", "funnel-img" %}
    </div>
    <div class="funnel-sub-title">
      <h1 class="indirect-title">{{ locales.homePage.subtitle[locale] | safe }}</h1>
    </div>
    <p class="funnel-desc">{{ locales.homePage.description[locale] }}</p>
    <a class="funnel-link" href="{{ locales.homePage.contactUrl[locale] }}">{{ locales.homePage.contactBtn[locale] }}</a>
  </div>
</section>

<!-- Pré-renderiza todas as imagens otimizadas no build -->
<template id="optimized-images">
  {% for proj in home %}
  <div data-project-url="{{ proj.url }}">
    {% image proj.img, proj.title, "hero-img", "(max-width: 768px) 100vw, 800px" %}
  </div>
  {% endfor %}
</template>

<script>
  const allProjects = {{ home | dump | safe }};

  function getWeightedRandom(projects, count) {
    let result = [];
    let pool = [...projects];

    for (let i = 0; i < count; i++) {
      if (pool.length === 0) break;

      let totalWeight = pool.reduce((sum, p) => sum + p.weight, 0);
      let random = Math.random() * totalWeight;

      for (let j = 0; j < pool.length; j++) {
        random -= pool[j].weight;

        if (random <= 0) {
          result.push(pool[j]);
          pool.splice(j, 1);
          break;
        }
      }
    }
    return result;
  }

  const maxToDraw = Math.min(10, allProjects.length);
  const selectedProjects = getWeightedRandom(allProjects, maxToDraw);

  const ul = document.getElementById('hero-list');
  const templateImages = document.getElementById('optimized-images').content;
  let html = '';

  selectedProjects.forEach((proj, index) => {
    const num = String(index + 1).padStart(2, '0');
    const pictureTag = templateImages.querySelector(`[data-project-url="${proj.url}"]`).innerHTML;

    html += `
        <li>
          <a href="${proj.url}">
            <p>[&nbsp&nbsp]</p>
            <div>
              <p>${proj.title}</p>
              <p>${proj.type}</p>
              <p>${proj.year}</p>
            </div>
          </a>
        </li>
        <div class="hero-picture-wrapper">
          ${pictureTag}
        </div>
      `;
  });

  ul.innerHTML = html;
</script>

<script src="/js/home.js"></script>